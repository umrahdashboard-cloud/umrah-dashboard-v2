# Supabase (required for cloud sync; app falls back to in-memory demo store if unreachable)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session signing (set a long random string in production)
SESSION_SECRET=

# Public site URL (used by payment gateway callbacks)
NEXT_PUBLIC_BASE_URL=https://your-site.netlify.app

# Optional
BACKUP_RESTORE_PASSWORD=
